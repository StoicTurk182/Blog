[
{{- $first := true -}}
{{- range (where site.RegularPages "Section" "in" (slice "posts" "tools")) -}}
    {{- if not $first }},{{ end -}}
    {{- $first = false -}}
    
    {{- $img := "" -}}
    
    {{- /* 1. Tool-specific */ -}}
    {{- if .Params.tool_image -}}
        {{- $img = .Params.tool_image | relURL -}}
    
    {{- /* 2. Check both featured_image and featuredImage */ -}}
    {{- else if .Params.featured_image -}}
        {{- $img = .Params.featured_image | relURL -}}
    {{- else if .Params.featuredImage -}}
        {{- $img = .Params.featuredImage | relURL -}}

    {{- /* 3. Thumbnail */ -}}
    {{- else if .Params.thumbnail -}}
        {{- $img = .Params.thumbnail | relURL -}}

    {{- /* 4. Fallback: Resources */ -}}
    {{- else -}}
        {{- $resource := (.Resources.ByType "image").GetMatch "{*featured*,*thumbnail*,*cover*}" -}}
        {{- if $resource -}}
            {{- $img = $resource.RelPermalink -}}
        {{- end -}}
    {{- end -}}

    {{ dict "title" .Title "permalink" .RelPermalink "summary" .Summary "content" .Plain "image" $img | jsonify }}
{{- end -}}
]